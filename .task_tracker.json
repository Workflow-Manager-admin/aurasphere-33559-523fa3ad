{
  "task_description": "{'component_name': 'Main Container for AuraSphere', 'description': 'Primary container for AuraSphere implementation: MyAuraGram is a full-stack social media platform inspired by Instagram, designed to be a digital aura space where users express their moods, emotions, and energy through posts. The app supports image/video uploads, stories, real-time notifications, direct messaging, and an explore page. It features robust authentication, responsive design, and an admin dashboard for content moderation. Aesthetic UI/UX with animations and mood-based color themes enhances user experience. Built with React.js/Next.js, Tailwind CSS, and Firebase/Supabase for backend and media storage.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Sign up and log in with email or Google using Firebase Auth or Auth0.",\n      "isEnabled": true\n    },\n    {\n      "name": "Profile Management",\n      "description": "Create and edit profile with bio, avatar, and username. Choose profile color themes.",\n      "isEnabled": true\n    },\n    {\n      "name": "Media Uploads",\n      "description": "Upload images and short videos with captions, hashtags, and mood-based filter suggestions. Media stored in Cloudinary or Firebase Storage.",\n      "isEnabled": true\n    },\n    {\n      "name": "Feed",\n      "description": "Scrollable feed of posts from followed users with vibey, animated design.",\n      "isEnabled": true\n    },\n    {\n      "name": "Engagement",\n      "description": "Like, comment, and save posts. Real-time notifications for likes, comments, and follows.",\n      "isEnabled": true\n    },\n    {\n      "name": "Follow System",\n      "description": "Follow and unfollow users to curate your feed.",\n      "isEnabled": true\n    },\n    {\n      "name": "Explore Page",\n      "description": "Discover trending content and hashtags. AI-generated captions/hashtags for posts.",\n      "isEnabled": true\n    },\n    {\n      "name": "Stories",\n      "description": "24-hour disappearing content (images/videos).",\n      "isEnabled": true\n    },\n    {\n      "name": "Direct Messaging",\n      "description": "1-on-1 chat with media sharing, powered by Socket.io or Firebase Realtime DB.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dark/Light Mode",\n      "description": "Toggle between dark and light themes for the entire app.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Dashboard",\n      "description": "Monitor reports and flagged content for moderation.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive UI/UX",\n      "description": "Optimized for both mobile and desktop with smooth transitions and hover effects.",\n      "isEnabled": true\n    },\n    {\n      "name": "Audio Reels",\n      "description": "Create and share short audio-based reels (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Mood-based Filters",\n      "description": "Suggest filters based on user\'s selected mood or aura.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-generated Captions/Hashtags",\n      "description": "Suggest captions and hashtags using AI (optional feature).",\n      "isEnabled": true\n    },\n    {\n      "name": "Post Scheduling",\n      "description": "Schedule posts to be published at a later time (optional feature).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#ad0000",\n    "secondary": "#000000",\n    "accent": "#dbdad7"\n  },\n  "theme": "dark",\n  "layoutDescription": "The UI features a modern, card-based feed with smooth animations and transitions. The top navigation bar includes logo, search, and quick access to notifications, messages, and profile. The left sidebar (desktop) or bottom nav (mobile) provides links to Home, Explore, Create Post, and Profile. Stories are displayed at the top of the feed. The profile page showcases user posts, saved content, and customizable color themes. Admin dashboard is accessible via a separate route. All pages are responsive and optimized for touch and mouse interactions."\n}'}",
